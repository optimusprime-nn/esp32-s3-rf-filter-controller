CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Startup (Wi-Fi, bootstrap certificate, HTTPS) overflowed the default 3584 bytes.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Two NTP servers, as on the time server.
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# Boot new OTA images pending verification, and roll back if they are not confirmed.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# api.cloudflare.com and Let's Encrypt chains need cross-signed roots, as on the time server.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# TLS buffers (about 35 KB per open connection) in PSRAM, so dashboard sessions and
# certificate requests don't exhaust internal RAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
